config shellbox 'main'
	option enabled '1'
	option bind 'lan'
	option port '7682'
	option command '/bin/login'
	option font_size '14'
	option ssl '0'
	option ssl_cert ''
	option ssl_key ''
	option check_origin '0'
	option max_clients '0'
	option zmodem '0'
	option link_cwd '0'
	option per_page '50'
