#!/bin/sh /etc/rc.common
START=90
USE_PROCD=1

sfp_present() {
	case "$(jsonfilter -i /etc/board.json -e '@.features.sfp' 2>/dev/null)" in
		true|1|yes) return 0 ;;
		*) return 1 ;;
	esac
}

start_service() {
	/usr/libexec/network-opt-apply

	# sfp-apply exits immediately on boards without an SFP port. Starting it
	# with an unconditional procd respawn policy turns that exit into an
	# endless restart loop (and pegs the CPU), so only start it where an SFP
	# is actually present.
	sfp_present || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/sfp-apply
	procd_set_param respawn 0 0 0
	procd_close_instance
}

reload_service() {
	/usr/libexec/network-opt-apply
	sfp_present && /usr/libexec/sfp-apply
}

service_triggers() {
	procd_add_reload_trigger "network-opt"
	procd_add_reload_trigger "firewall"
}
